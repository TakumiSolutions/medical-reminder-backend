NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pharmacy_app
DB_PASSWORD=
DB_NAME=pharmacy_platform
# true for hosted MySQL that requires TLS (e.g. TiDB Cloud).
DB_SSL=false

# Frontend origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

SESSION_COOKIE_NAME=pharmacy_sid
SESSION_TTL_HOURS=12
# Must be true in production (HTTPS). Set false only for local HTTP development.
SESSION_COOKIE_SECURE=false
# lax: frontend on the same site as the API (or proxying /api). none: frontend on another domain.
SESSION_COOKIE_SAMESITE=lax

# Optional read-only access to each branch's Prompt export database (grant SELECT only).
PROMPT_DB_HOST=127.0.0.1
PROMPT_DB_PORT=3306
PROMPT_DB_USER=prompt_reader
PROMPT_DB_PASSWORD=
# true when the export databases are on hosted MySQL that requires TLS (e.g. TiDB Cloud).
PROMPT_DB_SSL=false
# Branch code -> Prompt export database name.
PROMPT_DATABASES=central:PharmacyExport,speedwell:PharmacyExportSpeedwell

# WhatsApp reminders (Meta WhatsApp Cloud API), one number per branch. A branch sends only
# when both its PHONE_NUMBER_ID and ACCESS_TOKEN are set. Messages use an approved template;
# WHATSAPP_TEMPLATE_PARAMS fills its {{1}}, {{2}}, ... in order (customer, medicine, branch, billdate).
# WHATSAPP_CENTRAL_PHONE_NUMBER_ID=
# WHATSAPP_CENTRAL_ACCESS_TOKEN=
# WHATSAPP_SPEEDWELL_PHONE_NUMBER_ID=
# WHATSAPP_SPEEDWELL_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=medicine_reminder
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_TEMPLATE_PARAMS=customer,medicine
# WHATSAPP_SEND_TIME=10:00
# Bills sent on WhatsApp as a PDF (automatically for bills whose remark is a day count, or
# with the Send button on a customer's bills). Needs an approved template with a DOCUMENT
# header; WHATSAPP_BILL_TEMPLATE_PARAMS fills its body {{1}}, {{2}}, ... in order.
# Turn on only after Meta has approved the bill template:
# WHATSAPP_AUTO_SEND_BILLS=true
# WHATSAPP_BILL_TEMPLATE_NAME=bill_copy
# WHATSAPP_BILL_TEMPLATE_PARAMS=customer,billno,billdate,total,branch
# BILL_STORE_NAME=Shivam Medical Store
# BILL_CENTRAL_HEADER=<address> | Ph: <phone> | GSTIN: <gstin> | DL No: <dl no>
# WhatsApp inbox webhook (Meta app → WhatsApp → Configuration): callback URL
# https://<backend>/webhooks/whatsapp, subscribe to "messages". App Secret: App settings → Basic.
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
