NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pharmacy_app
DB_PASSWORD=
DB_NAME=pharmacy_platform

# Frontend origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

SESSION_COOKIE_NAME=pharmacy_sid
SESSION_TTL_HOURS=12
# Must be true in production (HTTPS). Set false only for local HTTP development.
SESSION_COOKIE_SECURE=false

# Optional read-only access to each branch's ProntoZ export database (grant SELECT only).
PRONTOZ_DB_HOST=127.0.0.1
PRONTOZ_DB_PORT=3306
PRONTOZ_DB_USER=prontoz_reader
PRONTOZ_DB_PASSWORD=
# Branch code -> ProntoZ export database name.
PRONTOZ_DATABASES=central:PharmacyExport,speedwell:PharmacyExportSpeedwell
